{
    "name": "3d-plane",
    "version": "1.0.0",
    "description": "Web-based 3D model of a plane using Three.js",
    "type": "module",
    "main": "src/main.js",
    "scripts": {
        "dev": "vite",
        "start": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest run src",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test:visual": "playwright test",
        "test:visual:update": "playwright test --update-snapshots"
    },
    "dependencies": {
        "three": "0.184.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@playwright/test": "^1.60.0",
        "@types/three": "0.184.0",
        "eslint": "10.3.0",
        "globals": "17.6.0",
        "prettier": "3.8.3",
        "typescript": "6.0.3",
        "vite": "8.0.10",
        "vitest": "4.1.5"
    }
}
