{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "target": "ES2022",
        "lib": ["ES2022", "DOM"],
        "skipLibCheck": true
    },
    "include": ["src/**/*.js", "src/**/*.d.ts"]
}
